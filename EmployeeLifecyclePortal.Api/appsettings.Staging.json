{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=staging-mssql.database.windows.net;Database=EmployeeLifecyclePortal_Staging;User Id=admin;Password=${DB_PASSWORD};"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "EmployeeLifecyclePortal",
    "Audience": "EmployeeLifecyclePortalClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging.employeeportal.com",
      "https://app-staging.employeeportal.com"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "WindowMinutes": 1,
    "MaxRequestsPerWindow": 100
  },
  "Cache": {
    "Enabled": true,
    "DurationMinutes": 30,
    "RedisConnection": "${REDIS_CONNECTION_STRING}"
  },
  "Email": {
    "SmtpServer": "smtp.sendgrid.net",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "apikey",
    "Password": "${SENDGRID_API_KEY}"
  }
}
