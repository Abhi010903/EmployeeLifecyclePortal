{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=prod-mssql.database.windows.net;Database=EmployeeLifecyclePortal_Prod;User Id=admin;Password=${DB_PASSWORD};Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "EmployeeLifecyclePortal",
    "Audience": "EmployeeLifecyclePortalClient",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 30
  },
  "Https": {
    "Enabled": true,
    "Port": 443,
    "RedirectHttpToHttps": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://employeeportal.com",
      "https://app.employeeportal.com"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "WindowMinutes": 1,
    "MaxRequestsPerWindow": 60
  },
  "Cache": {
    "Enabled": true,
    "DurationMinutes": 60,
    "RedisConnection": "${REDIS_CONNECTION_STRING}"
  },
  "Security": {
    "RequireHttps": true,
    "AllowedHosts": [
      "employeeportal.com",
      "app.employeeportal.com",
      "api.employeeportal.com"
    ]
  },
  "Email": {
    "SmtpServer": "smtp.sendgrid.net",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "apikey",
    "Password": "${SENDGRID_API_KEY}"
  },
  "ApplicationInsights": {
    "InstrumentationKey": "${APPINSIGHTS_INSTRUMENTATION_KEY}"
  }
}
